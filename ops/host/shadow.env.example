# /etc/apex/shadow.env -- root:root 0600. Read by systemd for apex-shadow.service
# only. Names only here; the values come from the operator's .env:
#   APEX_SECRET_BLOCKPI_KEY  <- BLOCKPI_KEY
#   APEX_SECRET_TRADER_KEY   <- TRADER_PRIVATE_KEY (the trader, 0xCB43...)
# Never PRIVATE_KEY: that is the executor owner's key.
APEX_SECRET_BLOCKPI_KEY=
APEX_SECRET_TRADER_KEY=
