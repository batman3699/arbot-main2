# R41: the switch at Base's Denim hardfork. Started once by
# apex-denim-switch.timer; runs ops/host/denim-switch.sh as root, which detects
# the fork on chain, writes the drop-ins that point apex-canary and
# apex-armed-eval at the Denim configs, and restarts the canary. See
# ops/host/ARMED.md "The Denim day".
[Unit]
Description=APEX Denim switch (Task 8.5 R41): detect the fork on chain, then point the canary at the Denim config
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apex
ExecStart=/opt/apex/ops/host/denim-switch.sh
# Detection gives up at 20:00 UTC; this is the backstop.
TimeoutStartSec=2h30min
