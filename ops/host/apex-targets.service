[Unit]
Description=Build APEX Armed Lane v2 daily route targets
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apex/scripts/data
# R37: the day's new v4 pools into the inventory before the census (ARMED.md
# §3e): PoolManager's Initialize logs since the cursor, over the census's public
# endpoints, 50 blocks a query (never BlockPI's key). A failed scan ("-") does
# not stop the census.
ExecStartPre=-/usr/sbin/runuser -u apex -- /usr/bin/python3 v4_inventory.py --out /opt/apex/data/base/uniswap_v4/pools.jsonl --follow /opt/apex/var/census/v4-inventory.cursor --rpc public
ExecStart=/usr/sbin/runuser -u apex -- /usr/bin/nice -n 19 /usr/bin/python3 -m arb_census.targets --race /opt/apex/var/census --days 7 --top 50 --out /opt/apex/var/armed/targets.json --share-out /opt/apex/var/apex/armed-share.json --var /opt/apex/var/apex --meta /opt/apex/var/census/meta.json --gaps /opt/apex/var/census/r33-gaps.json --live-ledger /opt/apex/var/armed/armed-live.jsonl
ExecStartPost=/bin/systemctl restart apex-canary

# The census can scan multiple days through RPC when a day cache is missing:
# R34 took 70-120 min a day over public endpoints, so 30 min would kill it.
TimeoutStartSec=6h

