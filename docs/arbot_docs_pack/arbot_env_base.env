############################
# Arbot .env.base
# Base-only runtime profile
############################

############################
# Chain selection
############################
CHAIN=base
CHAIN_LIST=base
DOTENV_FILE=.env.base

############################
# RPC / provider endpoints
############################

# Fill this with your real upstream Base RPC.
BASE_UPSTREAM_RPC_URL=

# Main HTTP RPC used by runtime.
# Live mode: your upstream Base RPC
# Fork-debug mode: http://127.0.0.1:8546
BASE_RPC_URL=
BASE_RPC_URLS=

# Optional fallback list
BASE_RPC_URL_FALLBACKS=

# Optional websocket URL(s)
BASE_WS_RPC_URL=
BASE_WS_RPC_URLS=

# Optional special/private HTTP override
BASE_PRIVATE_RPC_HTTP_URL=

BASE_GAS_MODEL=op_stack

# Aerodrome pool inventory (required for Base solidly edge population).
BASE_SOLIDLY_V2_POOLS=config/base_aerodrome_pools.json

# Required when risk.per_chain.min_net_profit_usd is set in ops/inputs.yaml.
BASE_NATIVE_USD_PRICE=1665

############################
# Base protocol addresses
############################
BASE_UNIV3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
BASE_UNIV3_QUOTER=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
BASE_UNIV3_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
BASE_UNIVERSAL_ROUTER=0x6fF5693b99212Da76ad316178A184AB56D299b43
BASE_AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
# Aave V3 flash fee on Base is 5 bps (ops/inputs.yaml); do not use mainnet 9 bps default.
BASE_AAVE_FLASH_FEE_BPS=5
BASE_BAL_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
BASE_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

############################
# Executor / deploy values
############################
BASE_EXECUTOR_OWNER=0xD7A4D612E572B5877b0E2fC7cE8683e36360f04c
BASE_EXECUTOR_ADDRESS=0x9445f7d3E1aA38bC9A9B373dc905D9fde7B9B852
# On-chain: executor.owner() → BatchRouter; BatchRouter.owner() → BASE_EXECUTOR_OWNER
BASE_BATCH_ROUTER_ADDRESS=0x46C6d9003FB9FBFE29d60ae6feF869F7CAe6f499
# keccak256 of the deployed executor bytecode; REQUIRED in production mode.
# Compute after deploy: cast keccak "$(cast code $BASE_EXECUTOR_ADDRESS --rpc-url $BASE_RPC)"
BASE_EXECUTOR_CODEHASH=
PRIVATE_KEY=

############################
# Mode / role
############################
MEV_ROLE=searcher
# Shadow mode: set false/0 only when ready for live sequencer submission.
SHADOW_MODE=true
SHADOW_LOG_PATH=logs/shadow-base.jsonl
SHADOW_TAG=base-alchemy
OFFLINE_MODE=0
# Hot-pool ranking (shadow script exports override these at runtime).
HOT_POOL_SKIP_VOLUME=1
HOT_POOL_RANK_CONCURRENCY=32
HOT_POOL_RPC_TIMEOUT_MS=2000

############################
# Feature gates
# ops/inputs.yaml also lists enable_liquidations: [base]; env wins when set.
############################
FEATURE_CYCLE_ARB=true
FEATURE_BACKRUN=true
FEATURE_SANDWICH=false
FEATURE_LIQUIDATIONS=true
FEATURE_BRIDGE=false

############################
# Broadcast + relays
############################
# NEVER point Base at Ethereum Flashbots/Titan/Beaver relays — they do not serve Base.
# Ops/inputs.yaml private_relays are authoritative; these are fallbacks only.
ENABLE_DEFAULT_PRIVATE_RELAYS=false
BASE_PRIVATE_RELAY_URLS=https://base-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY},https://base-rpc.publicnode.com
BASE_PRIVATE_RELAY_URL=
# Do not set global PRIVATE_RELAY_URL(S) when running Base — use BASE_* prefixed keys only.
PRIVATE_RELAY_TIMEOUT_MS=2000
PUBLIC_MEMPOOL_JITTER_BPS=75

############################
# Sending / gas
############################
SEARCHER_PRIORITY_FEE_WEI=1000000000
FILLER_PRIORITY_FEE_WEI=2000000000
MAX_GAS_PRICE_WEI=80000000000
MAX_GAS_PRICE_CONGESTION_BPS=11500

############################
# Capital management
############################
BASE_AMOUNT_WEI=10000000000000000000
MIN_FLASH_LOAN_WEI=1000000000000000000
MAX_FLASH_LOAN_WEI=3000000000000000000000
REINVEST_BPS=10000
SIPHON_BPS=0
COMPOUND_GROWTH_UNIT_WEI=1000000000000000000
COMPOUND_MAX_BASE_WEI=100000000000000000000
SIPHON_THRESHOLD_WEI=0

############################
# Search + sizing
# ops/inputs.yaml universe.time_budget_ms wins when set (search/quoting/simulation).
############################
# 2 enables two-pool cross-venue arbs (the most frequent opportunity class).
MIN_HOPS=2
MAX_HOPS=6
MAX_HOPS_CAP=6
BELLMAN_MAX_RELAXATIONS=6
MAX_BELLMAN_CYCLES=14
MAX_CANDIDATE_PATHS=12

CYCLE_SEARCH_TIMEOUT_MS=550
QUOTE_BUDGET_MS=320
SIMULATION_BUDGET_MS=380
POOL_DEPTH_REFRESH_SECS=30
MAX_QUOTE_BLOCK_LAG=2

# Quote / populate concurrency (shadow script exports override these at runtime).
UNIV3_MAX_CONCURRENT_POOL_TASKS=32
UNIV3_QUOTE_CONCURRENCY=24
ARBOT_LOCAL_CL_QUOTES=1
ARBOT_BF_SKIP_ON_STABLE_GRAPH=0
ARBOT_SIM_REVM=1
ARBOT_SIM_L1_FEE=1
ARBOT_SIM_PREFETCH=1
ARBOT_SCAN_IDLE_SLEEP_MS=200
BACKRUN_POST_STATE=1

PROFIT_MARGIN_BPS=35
EDGE_SLIPPAGE_BPS=35
EDGE_MIN_HEALTH_SCORE_BPS=7000
EDGE_PRUNE_MAX_SLIPPAGE_BPS=50
EDGE_PRUNE_MIN_SCORE=1
EDGE_PRUNE_LIQUIDITY_WEIGHT=0.45
EDGE_PRUNE_PROFIT_WEIGHT=0.40
EDGE_PRUNE_SLIPPAGE_WEIGHT=0.15

MIN_EDGE_MAX_INPUT_WEI=0
MIN_LIQUIDITY_TOKENS=1
OPPORTUNITY_COST_WEI=0
CROSS_CHAIN_PROFIT_BPS=175
CROSS_CHAIN_MIN_PROFIT_WEI=0

############################
# Congestion / competition
############################
CONGESTION_EMA_ALPHA=0.30
COMPETITION_EMA_ALPHA=0.45

############################
# Health / circuit breaker
############################
CB_HOURLY_LOSS_LIMIT_WEI=200000000000000000
CB_DAILY_LOSS_LIMIT_WEI=1500000000000000000
CB_MAX_CONSECUTIVE_FAILURES=4

RPC_MAX_BACKOFF_SECS=30
WS_CONNECT_TIMEOUT_SECS=10

HEALTH_EMA_ALPHA=0.35
HEALTH_MAX_REJECT_RATE_EMA=0.10
HEALTH_MAX_LATENCY_MS_EMA=1500
HEALTH_MIN_SUCCESS_RATE_EMA=0.95

############################
# Monitoring
############################
PROMETHEUS_PORT=9100
RUST_LOG=info,arb_exec=info,arb_exec::venues=info,venue::univ3=warn,mempool=info

############################
# Chaos / test toggles
############################
CHAOS_RELAY_REJECT_BPS=0
CHAOS_PUBLIC_REJECT_BPS=0
CHAOS_BROADCAST_DELAY_MS=0
CHAOS_DISABLE_WS=false

############################
# Strategy-specific monitors
############################
BACKRUN_MONITOR=true
BACKRUN_MONITOR_ENABLED=true
BACKRUN_MIN_AMOUNT_WEI=0
BACKRUN_MIN_PRICE_IMPACT_BPS=0
BACKRUN_POLL_INTERVAL_MS=250

SANDWICH_MONITOR=false
SANDWICH_MONITOR_ENABLED=false
SANDWICH_MIN_PROFIT_WEI=0

BRIDGE_MAX_TIME_SECS=0
BRIDGE_ROUTES=0
BRIDGE_ROUTES_FILE=0

############################
# Pool / liquidity monitors
############################
LOW_LIQUIDITY_FACTORIES=
LOW_LIQUIDITY_LOOKBACK_BLOCKS=120
LOW_LIQUIDITY_MAX_TOTAL_TOKENS=20
LOW_LIQUIDITY_PRICE_DEVIATION_BPS=75
POOL_MONITOR_POLL_MS=60000
POOL_MONITOR_STALE_MS=300000

############################
# Accounting / alerts
############################
# ACCOUNTING_ENABLED=false
# ACCOUNTING_DIR=accounting
# ACCOUNTING_TRADE_LOG=accounting/trades.jsonl
# ACCOUNTING_DAILY_SUMMARY=accounting/daily.json
# ACCOUNTING_EVENT_LOG=accounting/events.jsonl
# TAX_RESERVE_BPS=0
# TAX_WALLET_ADDRESS=
# TAX_STABLECOIN_SYMBOL=USDC
# TAX_EXCHANGE_API_URL=
# TAX_EXCHANGE_API_KEY=
# ALERT_WEBHOOK_URL=
# ALERT_DAILY_NET_TARGET_WEI=0
# ALERT_REVERT_RATE_THRESHOLD=0.0
# ALERT_RPC_ERROR_RATE_THRESHOLD=0.0

############################
# Config parsing behavior
############################
OPS_INPUTS_STRICT=true
